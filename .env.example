# Generate a master key with `node scripts/setup.js`, then keep the real .env off Git.
AI_MASTER_KEY=
ADMIN_USERNAME=
MOBILE_LATEST_VERSION=0.2.2
MOBILE_MINIMUM_VERSION=0.2.2
MOBILE_DOWNLOAD_URL=/downloads/kaojiang-v0.2.2.apk
MOBILE_RELEASE_NOTES=新增应用内下载更新并保留浏览器下载；今日学习随机抽取30题，普通练习保留顺序与随机模式
PORT=5173
BIND_HOST=127.0.0.1
ALLOWED_HOSTS=127.0.0.1,localhost,::1
TRUST_PROXY=0
COOKIE_SECURE=0
DATA_DIR=./data
# Community text and image payload storage limit (default: 2GB).
COMMUNITY_STORAGE_LIMIT_BYTES=2147483648
# Optional password-gated one-click author API deployment.
AUTHOR_API_PASSWORD=
AUTHOR_API_KEY=
