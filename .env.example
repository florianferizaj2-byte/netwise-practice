# Generate a master key with `node scripts/setup.js`, then keep the real .env off Git.
AI_MASTER_KEY=
WECHAT_MINIPROGRAM_APP_ID=
WECHAT_MINIPROGRAM_APP_SECRET=
ADMIN_USERNAME=
MOBILE_LATEST_VERSION=0.3.5
MOBILE_MINIMUM_VERSION=0.2.8
MOBILE_DOWNLOAD_URL=/downloads/kaojiang-v0.3.5.apk
MOBILE_RELEASE_NOTES=练习页全新布局：顺序、随机、AI 出题与收藏、已生成题组入口更清晰，知识点支持展开、搜索和查看进度；修复 AI 模式下进入收藏的流程。网页新增 VIP 中心，支持签到、兑换和额度查询。
PORT=5173
BIND_HOST=127.0.0.1
ALLOWED_HOSTS=127.0.0.1,localhost,::1
TRUST_PROXY=0
COOKIE_SECURE=0
DATA_DIR=./data
# Community text and image payload storage limit (default: 2GB).
COMMUNITY_STORAGE_LIMIT_BYTES=2147483648
# Optional password-gated one-click author API deployment.
AUTHOR_API_PASSWORD=
AUTHOR_API_KEY=
