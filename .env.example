# Generate a master key with `node scripts/setup.js`, then keep the real .env off Git.
AI_MASTER_KEY=
WECHAT_MINIPROGRAM_APP_ID=
WECHAT_MINIPROGRAM_APP_SECRET=
ADMIN_USERNAME=
MOBILE_LATEST_VERSION=1.0.6
MOBILE_MINIMUM_VERSION=1.0.1
MOBILE_DOWNLOAD_URL=/downloads/kaojiang-v1.0.6.apk
MOBILE_RELEASE_NOTES=v1.0.6：新增连续答错1–5档语音；后台逐场景选择固定播放或所选候选池随机，下载后离线播放。
PORT=5173
BIND_HOST=127.0.0.1
ALLOWED_HOSTS=127.0.0.1,localhost,::1
TRUST_PROXY=0
COOKIE_SECURE=0
DATA_DIR=./data
# 可选：独立公告文件路径；留空时保存在 DATA_DIR/mobile-announcement.json
MOBILE_ANNOUNCEMENT_FILE=
# Community text and image payload storage limit (default: 2GB).
COMMUNITY_STORAGE_LIMIT_BYTES=2147483648
# Shared author AI service. Keep real credentials only in the server environment.
AI_SERVICE_API_KEY=
AI_SERVICE_BASE_URL=https://api.deepseek.com
AI_SERVICE_MODEL=deepseek-flash
# Optional primary administrator ID; otherwise ADMIN_USERNAME or the first admin.
AI_SERVICE_OWNER_ID=
# Optional usage-cost estimate. Set an exact matching model and CNY prices per million tokens.
# Leave blank for unknown cost. These are estimates, not provider billing.
AI_USAGE_PRICING_MODEL=
AI_USAGE_INPUT_CNY_PER_MILLION=
AI_USAGE_CACHED_INPUT_CNY_PER_MILLION=
AI_USAGE_OUTPUT_CNY_PER_MILLION=
# Legacy author environment configuration is also supported.
AUTHOR_API_PASSWORD=
AUTHOR_API_KEY=
AUTHOR_API_BASE_URL=https://api.deepseek.com
AUTHOR_API_MODEL=deepseek-flash

# Free desktop trial: limits count new requests, not reads of shared AI results.
GUEST_TRIAL_SESSIONS_PER_IP_DAY=20
GUEST_TRIAL_AI_PER_IP_DAY=100
GUEST_TRIAL_AI_PER_DAY=1000

# AI tasks: one task per account, with a bounded queue shared by all accounts.
AI_MAX_CONCURRENT_TASKS=3
AI_MAX_QUEUED_TASKS=40
AI_QUEUE_WAIT_MS=30000
AI_TASK_TIMEOUT_MS=180000
AI_GENERATION_MAX_ROUNDS=5

# Authentication limits are persisted in SQLite; all values must be positive.
AUTH_RATE_WINDOW_MS=900000
AUTH_LOGIN_IP_LIMIT=60
AUTH_LOGIN_ACCOUNT_LIMIT=20
AUTH_REGISTER_IP_LIMIT=10

# Account email verification is preserved but disabled by default.
AUTH_EMAIL_VERIFICATION_ENABLED=0
# Enable only after configuring and verifying an email delivery service.
# Use your mail provider's SMTP authorization password. Never put it in frontend code.
# 465 uses TLS; 587 requires STARTTLS. There is no insecure/debug-code fallback.
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=465
AUTH_SMTP_USER=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_FROM=
# Optional comma-separated disposable email domains; subdomains are also blocked.
AUTH_BLOCKED_EMAIL_DOMAINS=mailinator.com,guerrillamail.com,10minutemail.com,tempmail.com
