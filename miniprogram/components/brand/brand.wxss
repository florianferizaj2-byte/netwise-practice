.brand {
  align-items: center;
  display: flex;
  gap: 18rpx;
}

.seal {
  align-items: center;
  background: #3ac096;
  border-radius: 16rpx;
  display: flex;
  height: 84rpx;
  justify-content: center;
  transform: rotate(-3deg);
  width: 84rpx;
}

.seal text {
  color: #082016;
  font-size: 52rpx;
  font-weight: 800;
}

.wordmark {
  color: #f3f8f5;
  font-size: 46rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.brand-compact .seal {
  border-radius: 12rpx;
  height: 60rpx;
  width: 60rpx;
}

.brand-compact .seal text {
  font-size: 38rpx;
}
