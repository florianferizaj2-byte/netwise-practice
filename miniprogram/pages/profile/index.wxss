.profile-page {
  padding-top: 34rpx;
}

.profile-card {
  align-items: center;
  display: flex;
  gap: 22rpx;
  padding: 30rpx;
}

.avatar {
  align-items: center;
  background: #1e604b;
  border-radius: 50%;
  display: flex;
  height: 112rpx;
  justify-content: center;
  width: 112rpx;
}

.avatar text {
  color: #3ac096;
  font-size: 62rpx;
  font-weight: 800;
}

.profile-copy {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.profile-name {
  color: #f3f8f5;
  font-size: 36rpx;
  font-weight: 800;
}

.profile-subtitle {
  color: #a9bdb4;
  font-size: 24rpx;
}

.settings-card {
  margin-top: 24rpx;
  padding: 6rpx 26rpx;
}

.setting-row {
  align-items: center;
  border-bottom: 1rpx solid #2d473d;
  color: #f3f8f5;
  display: flex;
  font-size: 27rpx;
  justify-content: space-between;
  min-height: 100rpx;
}

.setting-row:last-child {
  border-bottom: 0;
}

.setting-value {
  color: #a9bdb4;
  font-size: 24rpx;
  max-width: 57%;
  overflow: hidden;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.setting-arrow {
  color: #3ac096;
  font-size: 38rpx;
  margin-left: 6rpx;
}

.ai-card {
  background: #1b382e;
  border-color: #315846;
  margin-top: 24rpx;
  padding: 26rpx;
}

.ai-title {
  color: #78e0b9;
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  margin-bottom: 12rpx;
}

.ai-text,
.secure-note {
  color: #c0d7cc;
  display: block;
  font-size: 24rpx;
  line-height: 1.7;
}

.sponsor-button {
  margin-top: 22rpx;
}

.secure-note {
  color: #71877d;
  font-size: 22rpx;
  margin: 18rpx 8rpx 0;
  text-align: center;
}

.logout-button {
  background: transparent;
  border: 1rpx solid #422726;
  border-radius: 16rpx;
  color: #f19a93;
  font-size: 27rpx;
  margin-top: 26rpx;
  min-height: 88rpx;
}

.modal-mask {
  align-items: center;
  background: rgba(2, 8, 6, 0.74);
  bottom: 0;
  display: flex;
  justify-content: center;
  left: 0;
  padding: 32rpx;
  position: fixed;
  right: 0;
  top: 0;
  z-index: 40;
}

.modal-card {
  background: #17231f;
  border: 1rpx solid #2d473d;
  border-radius: 26rpx;
  padding: 30rpx;
  width: 100%;
}

.modal-title {
  color: #f3f8f5;
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  margin-bottom: 16rpx;
}

.modal-text {
  color: #a9bdb4;
  display: block;
  font-size: 25rpx;
  line-height: 1.7;
  margin-bottom: 22rpx;
}

.modal-input {
  background: #0d1714;
  border: 1rpx solid #2d473d;
  border-radius: 14rpx;
  font-size: 27rpx;
  min-height: 88rpx;
  padding: 0 20rpx;
}

.modal-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 22rpx;
}

.modal-actions button {
  flex: 1;
  font-size: 25rpx;
  min-height: 80rpx;
}

.sponsor-modal {
  align-items: center;
  display: flex;
  flex-direction: column;
}

.sponsor-image {
  border-radius: 14rpx;
  height: 470rpx;
  margin-bottom: 16rpx;
  width: 470rpx;
}
