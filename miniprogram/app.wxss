page {
  background: #0d1714;
  color: #f3f8f5;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  min-height: 100%;
}

view,
text,
button,
input,
textarea,
scroll-view,
image {
  box-sizing: border-box;
}

button::after {
  border: 0;
}

button {
  border-radius: 0;
  line-height: 1.4;
  margin: 0;
  padding: 0;
}

input,
textarea {
  color: #f3f8f5;
}

.page-shell {
  min-height: 100vh;
  padding: 28rpx 32rpx 150rpx;
}

.page-header {
  align-items: flex-start;
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0 24rpx;
}

.eyebrow {
  color: #3ac096;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  margin-bottom: 8rpx;
}

.page-title {
  color: #f3f8f5;
  font-size: 56rpx;
  font-weight: 800;
  line-height: 1.2;
}

.muted {
  color: #a9bdb4;
}

.faint {
  color: #71877d;
}

.card {
  background: #17231f;
  border: 1rpx solid #2d473d;
  border-radius: 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(4, 14, 10, 0.18);
}

.primary-button {
  align-items: center;
  background: #3ac096;
  border-radius: 16rpx;
  color: #082016;
  display: flex;
  font-size: 30rpx;
  font-weight: 800;
  justify-content: center;
  min-height: 96rpx;
  padding: 0 26rpx;
}

.primary-button[disabled] {
  opacity: 0.55;
}

.secondary-button {
  align-items: center;
  background: transparent;
  border: 1rpx solid #2d473d;
  border-radius: 16rpx;
  color: #3ac096;
  display: flex;
  font-size: 28rpx;
  font-weight: 700;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 24rpx;
}

.error-text {
  color: #f19a93;
  font-size: 24rpx;
  line-height: 1.5;
  margin-top: 18rpx;
  text-align: center;
}

.success-text {
  color: #78e0b9;
  font-size: 24rpx;
  line-height: 1.5;
  margin-top: 18rpx;
  text-align: center;
}
