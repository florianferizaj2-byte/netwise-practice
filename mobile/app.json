{
  "expo": {
    "name": "考匠",
    "slug": "kaojiang",
    "version": "0.4.8",
    "scheme": "kaojiang",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "description": "考匠移动端学习应用",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF8F5",
          "image": "./assets/kaojiang-launch.png",
          "imageWidth": 112,
          "dark": { "backgroundColor": "#111A17", "image": "./assets/kaojiang-launch.png" }
        }
      ],
      "./plugins/withAppPermissions",
      "./plugins/withReleaseSigning",
      [
        "expo-image-picker",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.kaojiang.app",
      "versionCode": 33,
      "permissions": [
        "REQUEST_INSTALL_PACKAGES",
        "READ_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#C50606",
        "foregroundImage": "./assets/icon.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
