<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/rp_surface" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center_horizontal"
        android:paddingLeft="32dp" android:paddingRight="32dp" android:paddingTop="24dp" android:paddingBottom="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/route_player_name" android:textSize="16sp" android:textColor="@color/rp_text"
            android:fontFamily="sans-serif-medium" android:gravity="center" />
        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
        <TextView android:id="@+id/playerStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="40dp" android:gravity="center" android:fontFamily="sans-serif-medium"
            android:text="@string/simple_idle" android:textSize="26sp" android:textColor="@color/rp_text"
            android:accessibilityLiveRegion="polite" />
        <com.google.android.material.button.MaterialButton android:id="@+id/routeSelector"
            style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="24dp"
            android:paddingTop="12dp" android:paddingBottom="12dp" android:text="@string/route_selection_title"
            android:textSize="16sp" android:textAllCaps="false" android:gravity="start|center_vertical"
            app:cornerRadius="12dp" app:icon="@drawable/rp_ic_expand_more" app:iconGravity="end" />
        <TextView android:id="@+id/routeDetails" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:gravity="center" android:text="@string/simple_route_caption"
            android:textSize="14sp" android:textColor="@color/rp_muted" />
        <com.google.android.material.button.MaterialButton android:id="@+id/playPauseButton"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp"
            android:layout_marginTop="40dp" android:paddingTop="16dp" android:paddingBottom="16dp" android:text="@string/simple_start"
            android:textSize="20sp" android:textAllCaps="false" app:cornerRadius="16dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/playerStopButton"
            style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="64dp" android:layout_marginTop="16dp"
            android:paddingTop="16dp" android:paddingBottom="16dp" android:text="@string/simple_end" android:textSize="20sp"
            android:textAllCaps="false" android:enabled="false" app:cornerRadius="16dp" />
        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
        <TextView android:id="@+id/tutorialLink" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:minHeight="48dp" android:minWidth="120dp" android:layout_marginTop="40dp"
            android:padding="12dp" android:text="@string/simple_tutorial" android:textSize="14sp"
            android:textColor="?attr/colorPrimary" android:gravity="center" android:clickable="true"
            android:focusable="true" android:background="?attr/selectableItemBackground" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
